<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="prd.group_prd_user" model="res.groups">
            <field name="name">PRD User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="base.module_category_services_project"/>
        </record>

        <record id="prd.group_prd_manager" model="res.groups">
            <field name="name">PRD Administrator</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('prd.group_prd_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
