      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_prd_odoo_lincence_search" />
    </record>
    <menuitem id="menu_prd_odoo_lincence" name="Odoo Licences" parent="prd.menu_prd_configuration_root" action="action_prd_odoo_lincence" sequence="3" />

