<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Views and actions for prd.odoo_branches -->
    <record id="view_prd_odoo_branches_tree" model="ir.ui.view">
      <field name="name">prd.odoo_branches.tree</field>
      <field name="model">prd.odoo_branches</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" />
          <field name="active" />
        </list>
      </field>
    </record>
    <record id="view_prd_odoo_branches_form" model="ir.ui.view">
      <field name="name">prd.odoo_branches.form</field>
      <field name="model">prd.odoo_branches</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name" />
              <field name="active" />
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_prd_odoo_branches_search" model="ir.ui.view">
      <field name="name">prd.odoo_branches.search</field>
      <field name="model">prd.odoo_branches</field>
      <field name="arch" type="xml">
        <search>
          <field name="name" />
          <filter name="active" string="Active" domain="[('active','=',True)]" />
        </search>
      </field>
    </record>
    <record id="action_prd_odoo_branches" model="ir.actions.act_window">
      <field name="name">Odoo Branches</field>
      <field name="res_model">prd.odoo_branches</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_prd_odoo_branches_search" />
    </record>
    <menuitem id="menu_prd_odoo_branches" name="Odoo Branches" parent="prd.menu_prd_configuration_root" action="action_prd_odoo_branches" sequence="1" />

    <!-- Menu parent for Configuration -->

