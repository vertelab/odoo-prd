<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Search View -->
  <record id="view_prd_document_search" model="ir.ui.view">
    <field name="name">prd.document.search</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_search" />
    <field name="arch" type="xml">
      <field name="state" position="after">
        <field name="module_id" />
        <field name="repo_id" />
        <field name="application" />
        <field name="description" />
        <field name="summary" />
        <field name="shortdesc" />
        <field name="technical_name" />
      </field>
      <filter name="group_by_approved_by" position="after">
        <filter string="App Project" name="group_by_app_project" context="{'group_by':'repo_id'}" />
        <filter string="App Category" name="group_by_app_category" context="{'group_by':'app_category'}" />
        <filter string="App License" name="group_by_app_license" context="{'group_by':'licence_id'}" />
      </filter>
    </field>
  </record>
  <!-- Form View -->
  <record id="view_prd_document_form" model="ir.ui.view">
    <field name="name">prd.document.form</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_form" />
    <field name="arch" type="xml">
      <header position="inside">
        <button name="action_redirect_to_url" string="Export Module" type="object" class="oe_highlight" groups="prd.group_prd_manager" data-hotkey="m" invisible="not document_type == 'module'" />
        <button name="sftp_upload" string="SFTP Upload" type="object" class="oe_highlight" groups="prd.group_prd_manager" data-hotkey="m" invisible="not document_type == 'module'" />
      </header>
      <group id="c2" position="inside">

        <field name="application" invisible="not document_type == 'module'"/>
        <field name="description" invisible="not document_type == 'module'"/>
        <field name="app_category" invisible="not document_type == 'module'"/>
        <field name="icon" invisible="not document_type == 'module'"/>
        <field name="icon_image" invisible="not document_type == 'module'"/>
        <field name="module_id" invisible="not document_type == 'module'"/>
        <field name="repo_id" invisible="not document_type == 'module'"/>
        <field name="summary" invisible="not document_type == 'module'"/>
        <field name="shortdesc" invisible="not document_type == 'module'"/>
        <field name="technical_name" invisible="not document_type == 'module'"/>
        <field name="website" invisible="not document_type == 'module'"/>

      </group>
      <notebook position="inside">
        <page string="Index-file" id="index" invisible="not document_type == 'module'">
          <field name="description_html" />
        </page>
      </notebook>
    </field>
  </record>
  <!-- List (Tree) View -->
  <record id="view_prd_document_tree" model="ir.ui.view">
    <field name="name">prd.document.module</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_tree" />
    <field name="arch" type="xml">
      <list position="inside">
<!--
        <field name="sequence" widget="handle" optional="view" />
-->
        <field name="document_type" invisible="1" />
        <field name="repo_id" invisible="not document_type == 'module'"  optional="hide" /> 
        <field name="module_id" invisible="not document_type == 'module'" optional="hide"/>
        <field name="technical_name" invisible="not document_type == 'module'" optional="hide"/>
        <field name="shortdesc" invisible="not document_type == 'module'" optional="hide"/>
        <field name="application" invisible="not document_type == 'module'" optional="hide"/>
        <field name="summary" invisible="not document_type == 'module'" optional="hide"/>
        <field name="website" invisible="not document_type == 'module'" optional="hide"/>    
      </list>
    </field>
  </record>
</odoo>
