<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Search View -->
  <record id="view_prd_document_search" model="ir.ui.view">
    <field name="name">prd.document.search</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_search" />
    <field name="arch" type="xml">
      <field name="state" position="after">
        <field name="app_module" />
        <field name="app_project" />
        <field name="app_tree" />
        <field name="app_summary" />
        <field name="app_category" />
        <field name="app_manifest" />
        <field name="app_license" />
      </field>
      <filter name="group_by_approved_by" position="after">
        <filter string="App Project" name="group_by_app_project" context="{'group_by':'app_project'}" />
        <filter string="App Tree" name="group_by_app_tree" context="{'group_by':'app_tree'}" />
        <filter string="App Category" name="group_by_app_category" context="{'group_by':'app_category'}" />
        <filter string="App License" name="group_by_app_license" context="{'group_by':'app_license'}" />
      </filter>
    </field>
  </record>
  <!-- Form View -->
  <record id="view_prd_document_form" model="ir.ui.view">
    <field name="name">prd.document.form</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_form" />
    <field name="arch" type="xml">
      <header position="inside">
        <button name="action_redirect_to_url" string="Export Module" type="object" class="oe_highlight" groups="prd.group_prd_manager" data-hotkey="m" invisible="not document_type == 'module'" />
        <button name="sftp_upload" string="SFTP Upload" type="object" class="oe_highlight" groups="prd.group_prd_manager" data-hotkey="m" invisible="not document_type == 'module'" />
      </header>
      <group id="c2" position="inside">
<!--
        <field name="sequence" invisible="not document_type == 'module'" />
-->
        <field name="app_module" invisible="not document_type == 'module'" />
        <field name="app_tree" invisible="not document_type == 'module'" />
        <field name="app_icon" invisible="not document_type == 'module'" />
        <field name="app_url" invisible="not document_type == 'module'" />
        <field name="app_banner" invisible="not document_type == 'module'" />
        <field name="app_summary" invisible="not document_type == 'module'" />
        <field name="app_category" invisible="not document_type == 'module'" />
<!--
        <field name="app_description" invisible="not document_type == 'module'" />
-->
<!--
        <field name="app_manifest" invisible="not document_type == 'module'" />
-->
        <field name="app_license" invisible="not document_type == 'module'" />
<!--
        <field name="user_persona" invisible="not document_type == 'module'" />
        <field name="use_cases" invisible="not document_type == 'module'" />
        <field name="dependencies" invisible="not document_type == 'module'" />
-->
      </group>
      <notebook position="inside">
        <page string="Index-file" id="index" invisible="not document_type == 'module'">
          <field name="app_index" />
        </page>
      </notebook>
    </field>
  </record>
  <!-- List (Tree) View -->
  <record id="view_prd_document_tree" model="ir.ui.view">
    <field name="name">prd.document.module</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_tree" />
    <field name="arch" type="xml">
      <list position="inside">
        <field name="sequence" optional="view" />
        <field name="app_project" optional="hide" invisible="not document_type == 'module'" />
        <field name="app_module" optional="hide" invisible="not document_type == 'module'" />
        <field name="app_tree" optional="hide" invisible="not document_type == 'module'" />
        <field name="app_icon" optional="hide" invisible="not document_type == 'module'" />
        <field name="app_url" optional="hide" invisible="not document_type == 'module'" />
        <field name="app_summary" optional="hide" invisible="not document_type == 'module'" />
        <field name="app_category" optional="hide" invisible="not document_type == 'module'" />
        <field name="app_license" optional="hide" invisible="not document_type == 'module'" />
      </list>
    </field>
  </record>
</odoo>
