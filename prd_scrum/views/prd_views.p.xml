<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Form View -->
  <record id="view_prd_document_form" model="ir.ui.view">
    <field name="name">prd.document.form</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_form" />
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button class="oe_stat_button" type="object" name="action_user_stories" icon="fa-check">
          <div class="o_field_widget o_stat_info">
            <span class="o_stat_text">User Stories</span>
            <span class="o_stat_value">
              <field name="scrum_us_count" />
            </span>
          </div>
        </button>
        <button class="oe_stat_button" type="object" name="action_tasks" icon="fa-check">
          <div class="o_field_widget o_stat_info">
            <span class="o_stat_text">Tasks</span>
            <span class="o_stat_value">
              <field name="task_count" />
            </span>
          </div>
        </button>
      </div>
    </field>
  </record>
  <record id="view_prd_function_form" model="ir.ui.view">
    <field name="name">prd.function.form.us</field>
    <field name="model">prd.function</field>
    <field name="inherit_id" ref="prd.view_prd_function_form" />
    <field name="arch" type="xml">
      <field name="func_type" position="after">
        <field name="task_id" invisible="implementation_type != 'task'" required="implementation_type == 'task'" />
      </field>
      <notebook position="inside">
        <page string="User Stories">
          <field name="scrum_us_ids" context="{'default_func_id': id,}">
            <list string="User Stories" editable="bottom">
              <field name="sequence" widget="handle" />
              <field name="func_id"  invisible="1" />
              <field name="name" />
              <field name="actor_ids" widget="many2many_tags" />
              <field name="project_id" />
              <field name="stage_id" />
            </list>
          </field>
        </page>
      </notebook>
    </field>
  </record>
</odoo>
