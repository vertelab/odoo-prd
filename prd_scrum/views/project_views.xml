<odoo>

    <record id="view_project_task_func_button_form" model="ir.ui.view">
        <field name="name">project.task.func.button.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_get_funcs" icon="fa-check">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Functions</span>
                        <span class="o_stat_value">
                            <field name="func_count" />
                        </span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
