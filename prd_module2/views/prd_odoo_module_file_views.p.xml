<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Search View -->
  <record id="view_odoo_module_file_search" model="ir.ui.view">
    <field name="name">prd.odoo_module.file.search</field>
    <field name="model">prd.odoo_module.file</field>
    <field name="arch" type="xml">
      <search string="Module Files">
        <field name="name" />
        <field name="module_id" />
        <field name="git_url" />
        <filter string="Controllers" name="controllers" domain="[('file_type','=','controllers')]" />
        <filter string="Views" name="views" domain="[('file_type','=','views')]" />
        <filter string="Models" name="models" domain="[('file_type','=','models')]" />
        <filter string="Data" name="data" domain="[('file_type','=','data')]" />
        <separator />
        <group expand="0" string="Group By">
          <filter string="Module" name="group_module" context="{'group_by': 'module_id'}" />
          <filter string="File Type" name="group_type" context="{'group_by': 'file_type'}" />
        </group>
      </search>
    </field>
  </record>
  <!-- Tree/List View -->
  <record id="view_odoo_module_file_tree" model="ir.ui.view">
    <field name="name">prd.odoo_module.file.tree</field>
    <field name="model">prd.odoo_module.file</field>
    <field name="arch" type="xml">
      <!--
           <list string="Module Files" decoration-success="file_type=='views'" 
           decoration-info="file_type=='models'" 
           decoration-warning="file_type=='controllers'"
           decoration-muted="file_type=='static'">
      -->
      <list string="Module Files">
        <field name="name" />
        <field name="module_id" optional="hide" />
        <field name="file_type" optional="show" />
        <field name="git_url" optional="hide" />
      </list>
    </field>
  </record>
  <!-- Form View -->
  <record id="view_odoo_module_file_form" model="ir.ui.view">
      
    <field name="name">prd.odoo_module.file.form</field>
    <field name="model">prd.odoo_module.file</field>
    <field name="arch" type="xml">
      <form string="Module File">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="get_modules_files" type="object" string="Refresh File" class="oe_stat_button" icon="fa-refresh" />
          </div>
          <group>
            <group>
              <field name="name" />
              <field name="file_type" widget="badge" />
              <field name="content_type" />
              <field name="content_mime" />
              <field name="module_id" options="{'no_create': True}" invisible="1"/>
             
            </group>
            <group>
              <field name="git_url" widget="copy_clipboard" readonly="1" />
            </group>
          </group>
          <notebook>
            <page string="Content" id="content">
                <group>
              <field name="content_py"   nolabel="1" widget="ace" options="{'mode': 'python'}"     invisible="content_type != 'py'"/>
              <field name="content_xml"  nolabel="1" widget="ace" options="{'mode': 'qweb'}"       invisible="content_type != 'xml'"/>
              <field name="content_js"   nolabel="1" widget="ace" options="{'mode': 'javascript'}" invisible="content_type != 'js'"/>
              <field name="content_scss" nolabel="1" widget="ace" options="{'mode': 'scss'}"       invisible="content_type != 'scss'"/>
              <field name="content_json" nolabel="1" widget="ace" options="{'mode': 'json'}"       invisible="content_type != 'json'"/>
              <field name="content_txt"  nolabel="1" widget="ace" options="{'mode': 'text'}"       invisible="content_type != 'txt'"/>
              </group>
              <group>
              <field name="content_bin"  nolabel="1" widget="image"                   invisible="not 'image/' in content_mime"/>
              <field name="content_bin"  nolabel="1" widget="pdf_viewer"              invisible="not 'application/pdf' in content_mime"/>
              <field name="content_bin"  nolabel="1" widget="binary"                  invisible="('image/' in content_mime or 'application/pdf' in content_mime or 'text/plain' in content_mime)"/>
              </group>
             
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Kanban View -->
  <record id="view_odoo_module_file_kanban" model="ir.ui.view">
    <field name="name">prd.odoo_module.file.kanban</field>
    <field name="model">prd.odoo_module.file</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_dashboard" default_group_by="file_type">
        <field name="name" />
        <field name="module_id" />
        <field name="file_type" />
        <field name="git_url" />
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div class="oe_kanban_details">
                <field name="file_type" widget="badge" class="oe_kanban_badge" />
                <strong class="oe_kanban_title">
                  <span>
                    <field name="name" />
                  </span>
                </strong>
                <div class="oe_kanban_subtitle">
                  <span>
                    <field name="module_id" />
                  </span>
                </div>
              </div>
              <div class="oe_kanban_bottom_left">
                <a t-att-href="record.git_url.value or '#'" target="_blank" class="btn btn-sm btn-link p0" title="Git URL">
                  <i class="fa fa-external-link" />
                </a>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <!-- Action -->
  <record id="action_odoo_module_file" model="ir.actions.act_window">
    <field name="name">Module Files</field>
    <field name="res_model">prd.odoo_module.file</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_odoo_module_file_search" />
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Skapa eller ladda upp filer från Git-repo</p>
      <p>Använd "Refresh Files" knappen på modulförälder för att ladda filer från Git.</p>
    </field>
  </record>
  <record id="view_prd_document_form" model="ir.ui.view">
    <field name="name">prd.document.form.files</field>
    <field name="model">prd.document</field>
    <field name="inherit_id" ref="prd.view_prd_document_form" />
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button class="oe_stat_button" type="object" name="action_files" icon="fa-check" string="Files">
          <div class="o_field_widget o_stat_info">
            <span class="o_stat_text">Files</span>
            <span class="o_stat_value">
              <!--
                   <field name="files_count" />
              -->
            </span>
          </div>
        </button>
      </div>
    </field>
  </record>
  <record id="view_prd_odoo_module_form" model="ir.ui.view">
    <field name="name">prd.odoo_module.form.files</field>
    <field name="model">prd.odoo_module</field>
    <field name="inherit_id" ref="prd.view_prd_odoo_module_form" />
    <field name="arch" type="xml">
      <header position="inside">
        <button name="button_get_module_files" string="Get Files" type="object" class="oe_highlight" />
      </header>
      <div name="button_box" position="inside">
        <button class="oe_stat_button" type="object" name="action_files" icon="fa-check" string="Files">
          <div class="o_field_widget o_stat_info">
            <span class="o_stat_text">Files</span>
            <span class="o_stat_value">
              <field name="files_count" />
            </span>
          </div>
        </button>
      </div>
      <field name="repo_id" position="after">
        <field name="branch_id" />
      </field>
    </field>
  </record>
  <!-- Menu -->
  <!--
       <menuitem id="menu_odoo_module_file_root" 
       name="Module Files" 
       action="action_odoo_module_file" 
       parent="prd.menu_prd_root"
       sequence="20"/>
  -->
</odoo>
