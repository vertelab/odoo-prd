<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prd_export_import_form" model="ir.ui.view">
        <field name="name">prd.export.import.form</field>
        <field name="model">prd.export.import</field>
        <field name="arch" type="xml">
            <form string="Export/Import PRDs">
                <notebook>
                    <page string="Export PRDs">
                        <group>
                            <group>
                                <field name="export_format" 
                                       options="{'no_create': True}"/>
                                <field name="prd_ids"
                                       widget="many2many_tags"
                                       placeholder="Select PRDs to export"/>
                            </group>
                        </group>
                        <footer>
                            <button name="action_export" 
                                    string="Export Selected PRDs"
                                    type="object" 
                                    class="btn-primary me-2"/>
                            <button string="Cancel" 
                                    class="btn-secondary" 
                                    special="cancel"/>
                        </footer>
                    </page>
                    <page string="Import PRDs">
                        <group>
                            <group>
                                <field name="data_file" 
                                       filename="filename"
                                       placeholder="Upload JSON/XML file"/>
                                <field name="filename" invisible="1"/>
                            </group>
                        </group>
                        <footer>
                            <button name="action_import" 
                                    string="Import PRDs"
                                    type="object" 
                                    class="btn-primary me-2"
                                    invisible="not data_file"/>
                            <button string="Cancel" 
                                    class="btn-secondary" 
                                    special="cancel"/>
                        </footer>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="action_prd_export_import" model="ir.actions.act_window">
        <field name="name">Export/Import PRDs</field>
        <field name="res_model">prd.export.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_prd_export_import"
              name="Export/Import PRDs"
              parent="prd.menu_prd_configuration_root"
              action="action_prd_export_import"
              sequence="200"/>
</odoo>
