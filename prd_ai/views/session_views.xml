<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PRD-kontextvyer (prd-ai-coworkers 5.1). Domänfältet prd_id finns
         bara när prd_ai är installerat; vyerna ärver core-vyerna
         (Odoo 18: list, aldrig tree). -->

    <!-- Session-list: PRD-kolumn -->
    <record id="view_ai_session_list_prd" model="ir.ui.view">
        <field name="name">ai.coworker.session.list.prd</field>
        <field name="model">ai.coworker.session</field>
        <field name="inherit_id" ref="ai_agent_core.view_ai_session_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coworker_id']" position="after">
                <field name="prd_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Session-form: prd_id read-only -->
    <record id="view_ai_session_form_prd" model="ir.ui.view">
        <field name="name">ai.coworker.session.form.prd</field>
        <field name="model">ai.coworker.session</field>
        <field name="inherit_id" ref="ai_agent_core.view_ai_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="prd_context" string="PRD-kontext">
                    <field name="prd_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
