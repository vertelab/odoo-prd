<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Search View -->
  <record id="view_prd_function_search" model="ir.ui.view">
    <field name="name">prd.function.search</field>
    <field name="model">prd.function</field>
    <field name="arch" type="xml">
      <search string="PRD Functions">
        <field name="name" />
        <field name="state" />
        <field name="func_type" />
        <field name="prd_id" />
        <field name="user_id" />
        <filter name="draft" string="Draft" domain="[('state','=','draft')]" />
        <filter name="ongoing" string="Ongoing" domain="[('state','=','ongoing')]" />
        <filter name="done" string="Done" domain="[('state','=','done')]" />
        <filter name="my_functions" string="My Functions" domain="[('user_id','=',uid)]" groups="base.group_user" />
        <filter name="no_req" string="Missing Requirement" domain="[('requirement_ids','=',False)]" groups="base.group_user" />
        <filter string="Archived" name="archive" domain="[('active','=',False)]" />
        <filter name="to_check" string="To Check" domain="[('to_check','=',True)]" />
        <group expand="1" string="Group By">
          <filter string="Responsible" name="group_by_user" context="{'group_by':'user_id'}" />
          <filter string="Type" name="group_by_func_type" context="{'group_by':'func_type'}" />
          <filter string="State" name="group_by_state" context="{'group_by':'state'}" />
        </group>
      </search>
    </field>
  </record>
  <!-- Form View -->
  <record id="view_prd_function_form" model="ir.ui.view">
    <field name="name">prd.function.form</field>
    <field name="model">prd.function</field>
    <field name="arch" type="xml">
      <form string="PRD Function">
        <header>
          <field name="state" widget="statusbar_duration" options="{'clickable': '1', 'fold_field': 'fold'}" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box" groups="base.group_user" />
<!--
          <group>
-->
            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
<field name="icon_image" nolabel="1" widget="image" class="oe_avatar me-3"  style="width: 128px; height: 128px; flex: 0 0 auto;"/>  
            <div class="oe_title flex-grow-1 w-80">
                    <label for="name" string="Name"/>
              <h1 class="d-flex flex-row">
                <field name="name" options="{'line_breaks': False}" widget="text" class="w-80 flex-grow-1 o_text_overflow" placeholder="e.g. Function" />
              </h1>
            </div>            
<!--
            <field name="image_128" nolabel="1" widget="image" class="oe_avatar me-3"  style="width: 128px; height: 128px; flex: 0 0 auto;"/>  
-->
            
<!--
          </group>
-->
          <group col="2">
            <group id="c1">
              <field name="func_type" />
              <field name="implementation_type" invisible="1" />
              <field name="module_id" invisible="implementation_type != 'module'" required="implementation_type == 'module'" />
              <field name="module_prd_id" invisible="implementation_type != 'prd'" required="implementation_type == 'prd'" />
              <field name="user_id" />
              <field name="prd_id" invisible="1" />
              <field name="odoo_view_ids" widget="many2many_tags" />
              <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': true}" />
              <field name="to_check" widget="boolean_toggle" />
            </group>
            <group id="c2">
              <field name="application" invisible="implementation_type != 'module'" />
              <field name="description" invisible="implementation_type != 'module'" />
              <field name="description_html" invisible="implementation_type != 'module'" />
              <field name="icon" invisible="implementation_type != 'module'" />
              <field name="icon_image" invisible="implementation_type != 'module'" />
              <field name="repo_id" invisible="implementation_type != 'module'" />
              <field name="shortdesc" invisible="implementation_type != 'module'" />
              <field name="technical_name" invisible="implementation_type != 'module'" />
              <field name="website" invisible="implementation_type != 'module'" />
            </group>
          </group>
          <notebook>
            <page string="Description">
              <field name="description" nolabel="1" />
            </page>
            <page string="Input Data">
              <field name="input_data" nolabel="1" />
            </page>
            <page string="Process Data">
              <field name="process_data" nolabel="1" />
            </page>
            <page string="Output Data">
              <field name="output_data" nolabel="1" />
            </page>
            <page string="Requirements">
              <field name="requirement_ids" context="{
    'default_func_id': id,
    'default_prd_id': prd_id
}">
                <list string="Requirements" editable="bottom">
                  <field name="sequence" widget="handle" />
                  <field name="req_id" context="{
    'default_prd_id': prd_id
}" />
                  <field name="func_type" />
                  <field name="state" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
  
  <!-- List View -->
  <record id="view_prd_function_tree" model="ir.ui.view">
    <field name="name">prd.function.tree</field>
    <field name="model">prd.function</field>
    <field name="arch" type="xml">
      <list string="PRD Functions" decoration-warning="to_check">
        <field name="sequence" widget="handle" />
        <field name="name" />
        <field name="func_type" optional="show" />
        <field name="user_id" optional="show" />
        <field name="state" optional="show" />
        <field name="to_check" optional="hide" />
      </list>
    </field>
  </record>
  
  <!-- Kanban View -->
  <record id="view_prd_function_kanban" model="ir.ui.view">
    <field name="name">prd.function.kanban</field>
    <field name="model">prd.function</field>
    <field name="arch" type="xml">
      <kanban>
        <field name="name" />
        <field name="state" />
        <field name="summary" />
        <field name="website" />
        <field name="application" />
        <field name="func_type" />
        <field name="requirement_ids" />
        <field name="requirement_names_ids" />
        <field name="implementation_type" />
        <field name="user_id" />
        <templates>
          <t t-name="menu">
            <t t-if="record.implementation_type.raw_value">
                 <t t-set="itype" t-value="record.implementation_type.raw_value" />
            </t>
            <t t-else="">
                 <t t-set="itype" t-value="tom" />
            </t>
                             
            <a type="open" class="dropdown-item">Module Info</a>
            <a t-if="record.website.raw_value" role="menuitem" class="dropdown-item o-hidden-ios" t-att-href="record.website.raw_value" target="_blank">Learn More</a>
          </t>
          <t t-name="card" class="flex-row align-items-center">
            <aside>
              <field name="icon" widget="image_url" options="{'size': [50, 50]}" alt="Icon" t-if="record.implementation_type.raw_value == 'module'"/>                              
               <field name="avatar_128" alt="Contact image" widget="image" options="{'img_class': 'object-fit-cover'}" t-if="record.implementation_type.raw_value != 'module'" />
            </aside>
<!--
            <main class="me-4" t-att-title="record.shortdesc.value">
-->
            <main class="me-4" >
                
      <widget name="web_ribbon" title="Done"
              bg_color="bg-success" icon="fa-times"
              invisible="state != 'done'"/>
      
      <widget name="web_ribbon" title="Ongoing"
              bg_color="bg-warning" icon="fa-file-text"
              invisible="state != 'ongoing'"/>
      
      <widget name="web_ribbon" title="Draft"
              bg_color="bg-danger" icon="fa-times"
              invisible="state != 'draft'"/>

      <widget name="web_ribbon" title="To Check"
              bg_color="bg-warning" icon="fa-file-text"
              invisible="to_check == False"/>
                
              <field class="fw-bold fs-5" name="name" />
              <p class="text-muted small my-0 lh-sm">
    
                <div>
                  <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': true}" />
                  <field name="requirement_names_ids" widget="many2many_tags"  />
                                    
                </div>
              
              </p>
              <footer class="w-100 justify-content-between">
                    
        <field name="user_id" widget="many2one_avatar_user" />
        <field name="func_type" />
<!--
        <field name="state" widget="label_selection"/>
-->
                <a t-att-href="record.website.raw_value" target="_blank" invisible="website in (False, '')" class="btn btn-sm btn-secondary float-end o-hidden-ios" role="button">Learn More</a>
<!--
                <a type="edit" class="btn btn-secondary btn-sm float-end" role="button" invisible="website != ''">Module Info</a>
-->
                 <field name="activity_ids" class="float-end" widget="kanban_activity"/>
                
              </footer>
            </main>
          </t>

        </templates>
      </kanban>
    </field>
  </record>
</odoo>
