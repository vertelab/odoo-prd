            </list>
        </field>
    </record>
    <record id="view_prd_function_type_form" model="ir.ui.view">
        <field name="name">prd.function_type.form</field>
        <field name="model">prd.function_type</field>
        <field name="arch" type="xml">
            <form string="Function Type">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="implementation_type" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List och form vy för prd.function_category -->
    <record id="view_prd_function_category_list" model="ir.ui.view">
        <field name="name">prd.function_category.list</field>
        <field name="model">prd.function_category</field>
        <field name="arch" type="xml">
            <list string="Function Categories">
                <field name="name" />
                <field name="color" widget="color_picker" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="view_prd_function_category_form" model="ir.ui.view">
        <field name="name">prd.function_category.form</field>
        <field name="model">prd.function_category</field>
        <field name="arch" type="xml">
            <form string="Function Category">
                <sheet>
                    <group>
                        <field name="name" required="1" />
                        <field name="color" widget="color_picker" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_prd_requirement_type" model="ir.actions.act_window">
        <field name="name">Requirement Types</field>
        <field name="res_model">prd.requirement_type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Klicka här för att skapa en ny kravtyp.</p>
        </field>
    </record>
    <record id="action_prd_requirement_category" model="ir.actions.act_window">
        <field name="name">Requirement Categories</field>
        <field name="res_model">prd.requirement_category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Klicka här för att skapa en ny kravkategori.</p>
        </field>
    </record>
    <record id="action_prd_odoo_view_type" model="ir.actions.act_window">
        <field name="name">Odoo View Types</field>
        <field name="res_model">prd.odoo_view_type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Klicka här för att skapa en ny vytyp.</p>
        </field>
    </record>
    <record id="action_prd_function_type" model="ir.actions.act_window">
