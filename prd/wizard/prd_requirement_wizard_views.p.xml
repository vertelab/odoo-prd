<odoo>
    
  <record id="prd_requirement_wizard_view" model="ir.ui.view">
    <field name="name">PRD Requirement Wizard</field>
    <field name="model">prd.requirement.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="user_id" widget="many2one_avatar_user"/>
        </group>
        <footer>
          <button name="set_responsible" string="Set" type="object" class="oe_highlight" />
          <button name="cancel" string="Cancel" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  
</odoo>
