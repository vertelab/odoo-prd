<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_prd_requirement" model="ir.actions.report">
    <field name="name">PRD Requirement</field>
    <field name="model">prd.requirement</field>
    <field name="report_type">qweb-pdf</field>
    <!-- tekniskt namn på rapporten -->
    <field name="report_name">prd.report_prd_requirement</field>
    <!-- QWeb-templatefil (kan vara samma som report_name) -->
    <field name="report_file">prd.report_prd_requirement</field>
    <!-- skrivs ut i Print-menyn -->
    <field name="print_report_name">'PRD Requirement - %s' % (object.code or object.name)</field>
    <field name="binding_model_id" ref="model_prd_requirement" />
    <field name="binding_type">report</field>
  </record>
  <template id="report_prd_requirement">
    <t t-call="web.html_container">
      <!-- sortera gärna docs i python innan rapporten anropas,
           men om de redan kommer sorterade per req_type funkar detta -->
      <t t-set="current_type_id" t-value="False" />
      <!-- Ny typ? Lägg (ev.) sidbryt + H1 -->
      <t t-call="web.external_layout">
        <div class="page">
          <t t-foreach="docs" t-as="req">
            <t t-if="req.req_type and req.req_type.id != current_type_id">
              <!-- Sidbryt före NY typ, men inte före första -->
              <t t-if="current_type_id">
                <div style="page-break-before: always;" />
              </t>
              <!-- sätt nuvarande typ -->
              <t t-set="current_type_id" t-value="req.req_type.id" />
              <!-- H1 för typen högst upp på sidan -->
              <h1>
                <span t-esc="req.req_type.name or 'n/a'" />
                (<span t-esc="req.req_type.total" />)
              </h1>
            </t>
            <!-- Code + Name -->
            <h3>
              <span t-esc="req.code or ''" />&amp;nbsp;
              <span t-esc="req.name or ''" />
            </h3>
            <span t-esc="', '.join(req.category.mapped('name'))"/>
            <!-- Description -->
            <t t-if="req.description">
              <h4>Description</h4>
              <p t-esc="req.description" />
            </t>
            <!-- Comment (Html) -->
            <t t-if="req.note">
              <h4>Comment</h4>
              <div t-raw="req.note" />
            </t>
         
          </t>
        </div>
      </t>
    </t>
  </template>
  
  <record id="action_report_system_overview" model="ir.actions.report">
    <field name="name">System Overview - Module Functions</field>
    <field name="model">prd.requirement</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">prd.report_system_overview</field>
    <field name="report_file">prd.report_system_overview</field>
    <field name="print_report_name">'System overview - %s' % (object.prd_id.name)</field>
    <field name="binding_model_id" ref="model_prd_requirement"/>
    <field name="binding_type">report</field>
</record>

<template id="report_system_overview">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <h1>System overview - Module Functions</h1>
                
                <t t-set="report_data" t-value="docs[0].get_system_report_data(docs)"/>
                <t t-set="total" t-value="0"/>
                
                <table class="table table-sm table-bordered" style="width:100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Namn</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Beskrivning</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Krav</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Komplexitet</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="sorted(report_data.keys())" t-as="row">
                            <tr>
                                <td style="padding: 8px; border: 1px solid #dee2e6; vertical-align: top;">
                                    <strong t-esc="report_data[row]['name']"/>
                                </td>
                                <td style="padding: 8px; border: 1px solid #dee2e6;">
                                    <t t-esc="report_data[row]['description']"/>
                                </td>
                                <td style="padding: 8px; border: 1px solid #dee2e6;">
                                    <t t-esc="report_data[row]['requirements']"/>
                                </td>
                                <td style="padding: 8px; border: 1px solid #dee2e6; text-align: center;">
                                    <t t-esc="report_data[row]['complexity']"/>
                                </td>
                            </tr>
                             <t t-set="total" t-value="total + report_data[row]['time']"/>
                        
                        </t>
                        <tr>
                        <td style="padding: 8px; border: 1px solid #dee2e6; vertical-align: top;">
                                    <strong>Total</strong>
                                </td>
                                <td style="padding: 8px; border: 1px solid #dee2e6;">
                                    
                                </td>
                                <td style="padding: 8px; border: 1px solid #dee2e6;">
                                    
                                </td>
                                <td style="padding: 8px; border: 1px solid #dee2e6; text-align: center;">
                                    <t t-esc="total"/>
                                </td>
                            </tr>
                        
                    </tbody>
                </table>
                

            </div>
        </t>
    </t>
</template>

  
  
</odoo>
