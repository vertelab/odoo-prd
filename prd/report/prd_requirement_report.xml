<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_prd_requirement" model="ir.actions.report">
    <field name="name">PRD Requirement</field>
    <field name="model">prd.requirement</field>
    <field name="report_type">qweb-pdf</field>
    <!-- tekniskt namn på rapporten -->
    <field name="report_name">prd.report_prd_requirement</field>
    <!-- QWeb-templatefil (kan vara samma som report_name) -->
    <field name="report_file">prd.report_prd_requirement</field>
    <!-- skrivs ut i Print-menyn -->
    <field name="print_report_name">'PRD Requirement - %s' % (object.code or object.name)</field>
    <field name="binding_model_id" ref="model_prd_requirement" />
    <field name="binding_type">report</field>
  </record>
  <template id="report_prd_requirement">
    <t t-call="web.html_container">
      <!-- sortera gärna docs i python innan rapporten anropas,
           men om de redan kommer sorterade per req_type funkar detta -->
      <t t-set="current_type_id" t-value="False" />
      <!-- Ny typ? Lägg (ev.) sidbryt + H1 -->
      <t t-call="web.external_layout">
        <div class="page">
          <t t-foreach="docs" t-as="req">
            <t t-if="req.req_type and req.req_type.id != current_type_id">
              <!-- Sidbryt före NY typ, men inte före första -->
              <t t-if="current_type_id">
                <div style="page-break-before: always;" />
              </t>
              <!-- sätt nuvarande typ -->
              <t t-set="current_type_id" t-value="req.req_type.id" />
              <!-- H1 för typen högst upp på sidan -->
              <h1>
                <span t-esc="req.req_type.name or 'n/a'" />
              </h1>
            </t>
            <!-- Code + Name -->
            <h2>
              <span t-esc="req.code or ''" />
              -
              <span t-esc="req.name or ''" />
            </h2>
            <span t-esc="', '.join(req.category.mapped('name'))"/>
            <!-- Description -->
            <t t-if="req.description">
              <h3>Description</h3>
              <p t-esc="req.description" />
            </t>
            <!-- Comment (Html) -->
            <t t-if="req.note">
              <h3>Comments</h3>
              <div t-raw="req.note" />
            </t>
          <span t-esc="req.id"/>  
          </t>
        </div>
      </t>
    </t>
  </template>
</odoo>
